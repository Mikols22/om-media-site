# local | crm — explicit switch, defaults to "local" when unset.
# Set to "crm" only once the CRM app below is actually running.
SUBMISSIONS_MODE=local

CRM_API_BASE_URL=
CRM_API_KEY=

# Base URL for large media assets (video) hosted on Backblaze B2. Unset
# falls back to local /public paths — see src/lib/assets.ts.
NEXT_PUBLIC_ASSET_URL=https://f005.backblazeb2.com/file/om-media-site-assets
